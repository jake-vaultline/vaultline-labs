<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Ingest is standalone and has no Media Nexus, Relay, account, analytics,
      telemetry, update check, crash reporting, or other network client.
    -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!--
      Read-WRITE, unlike Inspector: this app copies media to destinations the
      user picks. It still only ever sees what they hand it.

      It never deletes or moves operator media. The only cleanup path removes
      marker-bound, lock-proven temporary transfer sessions created by this app;
      source cards are read and never modified.
    -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Remember destinations across launches without re-asking every ingest. -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
</dict>
</plist>
