<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      DIFFERENT POSTURE FROM DRIVE INSPECTOR — read this before copying either.

      Drive Inspector has NO network entitlement, and that provable restraint is
      its strongest claim. Ingest cannot make that claim: talking to a Media
      Nexus is the whole point of the paired mode.

      So the promise here is narrower and proved differently — every request the
      app makes is logged and shown in Settings (see NexusClient.NetworkLog).
      Unpaired, that log stays empty and the user can watch it stay empty.

      Consequences to hold on to:
        · No analytics, no telemetry, no update check, no crash reporting.
          The only host contacted is the Nexus address the user typed in.
        · Every request goes through NexusClient.send so the log is complete.
          A request that bypasses it makes the log decoration instead of evidence.
    -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Outbound only. The app is never a server. -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!--
      Read-WRITE, unlike Inspector: this app copies media to destinations the
      user picks. It still only ever sees what they hand it.

      It has no delete or move path — see OffloadEngine. Source cards are read
      and never modified.
    -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Remember destinations across launches without re-asking every ingest. -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
</dict>
</plist>
