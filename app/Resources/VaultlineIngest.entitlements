<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Ingest is standalone and has no Media Nexus or Relay client. Its optional
      Drive Passport feature requires outbound networking. Every such request
      goes through DrivePassportClient and appears in Settings → Network.

      No analytics, telemetry, update check, or crash reporting is present.
    -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Outbound is exclusively for the optional Drive Passport service. -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!--
      Read-WRITE, unlike Inspector: this app copies media to destinations the
      user picks. It still only ever sees what they hand it.

      It has no delete or move path — see OffloadEngine. Source cards are read
      and never modified.
    -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Remember destinations across launches without re-asking every ingest. -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
</dict>
</plist>
